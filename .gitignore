__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.venv/

# Git bundles produced for hand-off when a push is blocked
*.bundle

# Skills installed by `npx skills add`. Ignored rather than committed because
# their upstream licence could not be verified from this session (GitHub scope
# is limited to this repo), and vendoring third-party code of unknown licence
# is exactly what plovane/ingest/licensing.py refuses to do. Commit them
# deliberately, with attribution, once the licence is confirmed permissive.
.agents/
.claude/skills/
skills-lock.json

# Harvested datasets. Generated output, regenerated by `plovane.ingest`, and
# large. Keep them out of git and in a data store.
# Ignored per-file rather than as a directory, so the negation below can
# take effect -- git does not descend into an ignored directory.
ml/data/*
# ...but the hand-written training queries are not harvested code: they are
# small, authored here, and the training set is not reproducible without
# them, so they are tracked while entries.jsonl stays out.
!ml/data/queries.jsonl
# ...and the manifest of what the library was harvested from. entries.jsonl
# stays out as regenerable output; this is what makes it regenerable, so
# without it the committed model artefact could not be reproduced.
!ml/data/sources.json
!ml/data/README.md


# Encoder weights. Fetched via `ml/training/fetch_weights.py`; see ml/weights/README.md
# for the configured artefacts and their SHA-256 pins. Large and reproducible
# from the manifest, so they stay out of git -- the fetcher downloads what the
# manifest names.
ml/weights/*
!ml/weights/README.md
!ml/weights/manifest.json

# Library embeddings the model engine caches (regenerated on demand).
ml/serving/.cache/
# Recommendation and feedback logs the model service writes (training data; keep out of git).
ml/serving/.logs/

# Training outputs. Metrics JSON is committed; weights, logs and per-query
# scores are large or noisy and go to a GitHub release instead.
ml/artifacts/*.pt
ml/artifacts/*.log
ml/artifacts/*.jsonl
ml/artifacts/smoke/
