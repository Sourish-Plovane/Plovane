{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plovane:plo/0.1",
  "title": "Plovane whiteboard file (.plo) v0.1",
  "description": "Proposed. Confidential internal spec. Defines one project whiteboard: layers, roles, personal views, drawings, library references and a Plovane signature. Source code is not stored here; it stays in Git.",
  "type": "object",
  "additionalProperties": false,
  "required": ["plo_version", "project", "layers", "roles", "views", "drawings", "library", "signature"],
  "properties": {
    "plo_version": { "const": "0.1" },
    "project": { "$ref": "#/$defs/project" },
    "layers": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/layer" }
    },
    "roles": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/role" }
    },
    "views": {
      "description": "One saved personal view per user, keyed by user_id.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/personal_view" }
    },
    "drawings": {
      "type": "array",
      "items": { "$ref": "#/$defs/drawing" }
    },
    "library": {
      "type": "array",
      "items": { "$ref": "#/$defs/library_ref" }
    },
    "signature": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/signature" }
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "language": {
      "enum": ["javascript", "html", "css", "python", "pytorch", "cpp", "cuda"]
    },
    "node_type": {
      "enum": ["service", "folder", "file", "function", "endpoint", "finding"]
    },
    "relationship": {
      "enum": ["contains", "calls", "imports", "routes_to", "tests", "flags"]
    },
    "zoom_level": {
      "enum": ["services", "folders", "files", "steps", "code"]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "name", "repo", "commit", "languages"],
      "properties": {
        "project_id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "repo": { "type": "string", "minLength": 1 },
        "commit": {
          "description": "Commit the board was last synced against; null before first sync.",
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[0-9a-f]{7,64}$" }
          ]
        },
        "languages": {
          "type": "array",
          "items": { "$ref": "#/$defs/language" },
          "uniqueItems": true
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "oneOf": [
            { "enum": ["blue", "green", "orange", "red", "purple", "gray"] },
            { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
          ]
        },
        "badge": { "type": "string", "maxLength": 40 },
        "icon": { "type": "string" }
      }
    },
    "layer": {
      "oneOf": [
        { "$ref": "#/$defs/premade_layer" },
        { "$ref": "#/$defs/custom_layer" }
      ]
    },
    "premade_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "engine_ref"],
      "properties": {
        "source": { "const": "premade" },
        "engine_ref": {
          "description": "Versioned reference to a Plovane engine analyzer, e.g. plovane.layers.security@1.",
          "type": "string",
          "pattern": "^plovane\\.layers\\.[a-z_]+@[0-9]+$"
        },
        "style": { "$ref": "#/$defs/style" }
      }
    },
    "custom_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "created_by", "author", "match"],
      "properties": {
        "source": { "const": "custom" },
        "created_by": { "enum": ["ai", "user"] },
        "author": { "type": "string" },
        "description": { "type": "string" },
        "define_tags": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/tag_rule" }
        },
        "match": { "$ref": "#/$defs/match" },
        "style": { "$ref": "#/$defs/style" }
      }
    },
    "tag_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "language", "pattern"],
      "properties": {
        "engine": { "enum": ["tree_sitter", "semgrep"] },
        "language": { "$ref": "#/$defs/language" },
        "pattern": { "type": "string", "minLength": 1 }
      }
    },
    "traversal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["via", "tag"],
      "properties": {
        "via": { "$ref": "#/$defs/relationship" },
        "tag": { "$ref": "#/$defs/id" }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "node_type": { "$ref": "#/$defs/node_type" },
        "path": { "description": "Glob over source paths.", "type": "string" },
        "has_tag": { "$ref": "#/$defs/id" },
        "reaches": { "$ref": "#/$defs/traversal" },
        "not_reaches": { "$ref": "#/$defs/traversal" }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "layers", "default_zoom"],
      "properties": {
        "label": { "type": "string" },
        "layers": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true,
          "minItems": 1
        },
        "filters": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "enum": ["all", "only_with_findings"] }
        },
        "default_zoom": { "$ref": "#/$defs/zoom_level" }
      }
    },
    "personal_view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_role"],
      "properties": {
        "base_role": { "$ref": "#/$defs/id" },
        "layers_add": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "layers_remove": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "zoom": { "$ref": "#/$defs/zoom_level" },
        "focus": { "$ref": "#/$defs/selector" }
      }
    },
    "selector": {
      "description": "Binds a drawing to code. Resolved by the Plovane engine on every sync, so bound drawings follow the code.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "service": { "type": "string" },
        "folder": { "type": "string" },
        "file": { "type": "string" },
        "function": { "description": "path::qualified_name", "type": "string", "pattern": "^.+::.+$" },
        "endpoint": { "description": "METHOD /route", "type": "string", "pattern": "^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS) /.*$" },
        "node_id": { "type": "string" }
      }
    },
    "target": {
      "description": "A drawing id or a code selector.",
      "oneOf": [
        { "$ref": "#/$defs/id" },
        { "$ref": "#/$defs/selector" }
      ]
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "drawing_base": {
      "type": "object",
      "required": ["id", "type", "author"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["group", "note", "arrow", "shape"] },
        "author": { "type": "string" },
        "created_by": { "enum": ["ai", "user"] },
        "layer": { "$ref": "#/$defs/id" },
        "style": { "$ref": "#/$defs/style" },
        "position": { "$ref": "#/$defs/point" }
      }
    },
    "drawing": {
      "oneOf": [
        {
          "allOf": [{ "$ref": "#/$defs/drawing_base" }],
          "unevaluatedProperties": false,
          "required": ["label", "bind"],
          "properties": {
            "type": { "const": "group" },
            "label": { "type": "string" },
            "bind": { "$ref": "#/$defs/selector" }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/drawing_base" }],
          "unevaluatedProperties": false,
          "required": ["text"],
          "properties": {
            "type": { "const": "note" },
            "text": { "type": "string", "maxLength": 2000 },
            "attach": { "$ref": "#/$defs/target" }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/drawing_base" }],
          "unevaluatedProperties": false,
          "required": ["from", "to"],
          "properties": {
            "type": { "const": "arrow" },
            "from": { "$ref": "#/$defs/target" },
            "to": { "$ref": "#/$defs/target" },
            "label": { "type": "string" }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/drawing_base" }],
          "unevaluatedProperties": false,
          "required": ["kind", "position", "size"],
          "properties": {
            "type": { "const": "shape" },
            "kind": { "enum": ["rect", "ellipse"] },
            "label": { "type": "string" },
            "size": {
              "type": "object",
              "additionalProperties": false,
              "required": ["w", "h"],
              "properties": { "w": { "type": "number", "exclusiveMinimum": 0 }, "h": { "type": "number", "exclusiveMinimum": 0 } }
            }
          }
        }
      ]
    },
    "library_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "revision", "inserted_at", "credited_to"],
      "properties": {
        "block_id": { "type": "string" },
        "revision": { "type": "integer", "minimum": 1 },
        "inserted_at": { "$ref": "#/$defs/selector" },
        "credited_to": { "type": "string" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "key_id", "signed_at", "value"],
      "properties": {
        "alg": { "const": "ed25519" },
        "key_id": { "type": "string" },
        "signed_at": { "type": "string", "format": "date-time" },
        "value": { "type": "string", "contentEncoding": "base64" }
      }
    }
  }
}
