{
  "drawings": [
    {
      "author": "usr_sourish",
      "bind": { "folder": "src/payments" },
      "created_by": "user",
      "id": "d_payments",
      "label": "Payments service",
      "style": { "color": "blue" },
      "type": "group"
    },
    {
      "attach": "d_payments",
      "author": "usr_sourish",
      "created_by": "user",
      "id": "d_refactor_note",
      "text": "Refactor before launch",
      "type": "note"
    },
    {
      "author": "usr_aarav",
      "created_by": "ai",
      "from": "d_payments",
      "id": "d_charge_arrow",
      "label": "handles",
      "to": { "endpoint": "POST /charge" },
      "type": "arrow"
    },
    {
      "author": "usr_nirmal",
      "created_by": "user",
      "id": "d_external_box",
      "kind": "rect",
      "label": "Stripe (external)",
      "position": { "x": 840, "y": 120 },
      "size": { "h": 80, "w": 200 },
      "type": "shape"
    }
  ],
  "layers": {
    "endpoints": { "engine_ref": "plovane.layers.endpoints@1", "source": "premade" },
    "security": { "engine_ref": "plovane.layers.security@1", "source": "premade" },
    "structure": { "engine_ref": "plovane.layers.structure@1", "source": "premade" },
    "tests": { "engine_ref": "plovane.layers.tests@1", "source": "premade" },
    "unvalidated_db_writes": {
      "author": "usr_sourish",
      "created_by": "ai",
      "define_tags": {
        "db_write": {
          "engine": "semgrep",
          "language": "python",
          "pattern": "$CURSOR.execute(...)"
        }
      },
      "description": "Endpoints that write to the database without input validation.",
      "match": {
        "node_type": "endpoint",
        "not_reaches": { "tag": "input_validation", "via": "calls" },
        "reaches": { "tag": "db_write", "via": "calls" }
      },
      "source": "custom",
      "style": { "badge": "unvalidated write", "color": "orange" }
    }
  },
  "library": [
    {
      "block_id": "blk_csv_validator",
      "credited_to": "usr_nirmal",
      "inserted_at": { "function": "src/payments/import.py::load_ledger" },
      "revision": 2
    }
  ],
  "plo_version": "0.1",
  "project": {
    "commit": "d85a644",
    "languages": ["python", "javascript"],
    "name": "Example shop",
    "project_id": "proj_example_shop",
    "repo": "git@github.com:example/shop.git"
  },
  "roles": {
    "cyber": {
      "default_zoom": "services",
      "filters": { "endpoints": "only_with_findings" },
      "label": "Cyber security",
      "layers": ["security", "endpoints", "unvalidated_db_writes"]
    },
    "developer": {
      "default_zoom": "files",
      "label": "Developer",
      "layers": ["structure", "endpoints", "tests"]
    },
    "reviewer": {
      "default_zoom": "folders",
      "label": "Reviewer",
      "layers": ["structure", "tests"]
    }
  },
  "signature": null,
  "views": {
    "usr_sourish": {
      "base_role": "developer",
      "focus": { "service": "payments" },
      "layers_add": ["unvalidated_db_writes"],
      "zoom": "steps"
    }
  }
}
