  "display": {
    "endpoint": {
      "attach_to": "file_edge",
      "shape": "port",
      "show": [
        "method",
        "route"
      ]
    },
    "file": {
      "shape": "rounded",
      "show": [
        "name",
        "language_icon",
        "line_count"
      ],
      "size": {
        "by": "line_count",
        "max": [
          320,
          140
        ],
        "min": [
          160,
          60
        ]
      }
    },
    "folder": {
      "shape": "container",
      "show": [
        "name",
        "file_count"
      ]
    }
  },
  "format": "plovane-whiteboard",
  "layout": {
    "algorithm": "nested_grid",
    "collapsed": [
      "node_modules"
    ],
    "overlay_slots": {
      "badge": "top_right",
      "chip": "bottom",
      "icon": "top_left"
    },
    "sort_by": "name",
    "spacing": {
      "between_blocks": 24,
      "container_padding": 32
    }
  },
  "overlays": {
    "agent_access": {
      "appearance": {
        "1": "mark",
        "2": "mark",
        "3": "mark",
        "4": "mark"
      },
      "channel": "chip",
      "engine_ref": "plovane.overlays.agent_access@1",
      "label": "Agent access",
      "priority": 40,
      "source": "premade"
    },
    "code_vulnerabilities": {
      "appearance": {
        "1": "count",
        "2": "count",
        "3": "mark",
        "4": "mark",
        "5": "detail"
      },
      "channel": "border",
      "engine_ref": "plovane.overlays.code_vulnerabilities@1",
      "label": "Vulnerabilities in code",
      "parent": "cyber_security",
      "priority": 100,
      "source": "premade",
      "style": {
        "color": "red"
      }
    },
    "cyber_security": {
      "label": "Cyber security",
      "source": "group"
    },
    "leaked_secrets": {
      "appearance": {
        "1": "count",
        "2": "count",
        "3": "mark",
        "5": "detail"
      },
      "channel": "badge",
      "engine_ref": "plovane.overlays.leaked_secrets@1",
      "label": "Leaked secrets",
      "parent": "cyber_security",
      "priority": 100,
      "source": "premade",
      "style": {
        "badge": "secret",
        "color": "red"
      }
    },
    "test_health": {
      "appearance": {
        "1": "count",
        "2": "count",
        "3": "mark",
        "4": "mark"
      },
      "channel": "fill",
      "engine_ref": "plovane.overlays.test_health@1",
      "label": "Test health",
      "priority": 60,
      "source": "premade"
    },
    "unvalidated_db_writes": {
      "appearance": {
        "1": "count",
        "3": "mark"
      },
      "author": "usr_sourish",
      "channel": "badge",
      "created_by": "ai",
      "define_tags": {
        "db_write": {
          "engine": "semgrep",
          "language": "python",
          "pattern": "$CURSOR.execute(...)"
        }
      },
      "label": "Unvalidated database writes",
      "match": {
        "node_type": "endpoint",
        "not_reaches": {
          "tag": "input_validation",
          "via": "calls"
        },
        "reaches": {
          "tag": "db_write",
          "via": "calls"
        }
      },
      "parent": "cyber_security",
      "priority": 80,
      "source": "custom",
      "style": {
        "badge": "unvalidated write",
        "color": "orange"
      }
    }
  },
  "roles": {
    "cyber": {
      "default_level": 1,
      "label": "Cyber security",
      "overlays": [
        "cyber_security"
      ]
    },
    "developer": {
      "default_level": 3,
      "label": "Developer",
      "overlays": [
        "test_health",
        "agent_access"
      ]
    }
  },
  "version": 1,
  "views": {
    "usr_sourish": {
      "base_role": "developer",
      "focus": "src-payments",
      "level": 4,
      "overlays_add": [
        "unvalidated_db_writes"
      ]
    }
  }
